# ---------------------------------------------------------------------------
# AI Executive Assistant — configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# The app runs even with NO keys (demo mode); add keys to unlock the real
# transcription + AI features.
# ---------------------------------------------------------------------------

# --- Mode ------------------------------------------------------------------
# private = everything runs locally (local Whisper + local Ollama LLM); no data
#           leaves your machine. Use ./start-private.sh (Docker) for this.
# cloud   = use Anthropic + OpenAI APIs (best quality, least setup).
# auto    = use whichever keys/services are present (default).
MODE=auto

# --- Login -----------------------------------------------------------------
# Choose your own dashboard password. If left empty, a strong one is generated
# and printed to the server console on first start.
APP_PASSWORD=

# Signing key for login sessions. If empty, one is generated & saved locally.
SECRET_KEY=

# --- AI: understanding, extraction, chat (Anthropic Claude) ----------------
# Get a key at https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Force a provider: auto | anthropic | ollama | mock
LLM_PROVIDER=auto

# --- Local AI (private mode, via Ollama) -----------------------------------
OLLAMA_HOST=http://localhost:11434
# qwen2.5:7b (best, ~8GB RAM) | qwen2.5:3b | llama3.2:3b (lighter)
OLLAMA_MODEL=qwen2.5:7b

# --- Speech-to-text (OpenAI Whisper) ---------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Force a provider: auto | openai | local | mock
TRANSCRIBE_PROVIDER=auto

# --- Local speech-to-text (private mode, via faster-whisper) ---------------
# tiny | base | small | medium | large-v3   (bigger = better but slower)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# --- Storage ---------------------------------------------------------------
# Where your data lives (audio, database). Keep this on an encrypted disk.
# DATA_DIR=/absolute/path/to/data
# DB_PATH=/absolute/path/to/data/brain.db

# Session length in seconds (default 12h)
SESSION_TTL_SECONDS=43200

# ---------------------------------------------------------------------------
# AI PHONE AGENT (optional) — answers calls, records, emails you a summary.
# Cloud-only feature. See docs/05-ai-phone-agent.md for full setup.
# Leave empty to keep it disabled.
# ---------------------------------------------------------------------------
# Public HTTPS address of THIS server (Twilio must reach it). e.g. https://brain.example.com
PUBLIC_BASE_URL=
# Twilio (phone number). Get from https://twilio.com console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Realtime voice uses OPENAI_API_KEY (set above).
REALTIME_MODEL=gpt-4o-realtime-preview
REALTIME_VOICE=alloy
# The assistant's identity + greeting ({ceo} is replaced with CEO_NAME).
CEO_NAME=
AGENT_NAME=
# AGENT_GREETING=Hello, you've reached {ceo}'s AI assistant. This call may be recorded so I can take notes. How can I help?
CALL_RECORDING_ENABLED=true

# ---------------------------------------------------------------------------
# EMAIL SUMMARIES (optional) — where post-call summaries are sent.
# Works with any SMTP provider. Gmail: create an App Password.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
NOTIFY_EMAIL=
